<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VM Health Check" Height="640" Width="860" MinHeight="520" MinWidth="720" WindowStartupLocation="CenterScreen"
        Background="#0A1428" FontFamily="Segoe UI" FontSize="13" Foreground="#E6F1FF">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6F1FF"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6F1FF"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1730"/><Setter Property="Foreground" Value="#E6F1FF"/><Setter Property="BorderBrush" Value="#1E3560"/><Setter Property="Padding" Value="6,5"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2E55"/><Setter Property="Foreground" Value="#E6F1FF"/><Setter Property="BorderBrush" Value="#1E3560"/><Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#24407A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1E9BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#111F3A" BorderBrush="#1E3560" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Name="imgLogo" Width="44" Height="44" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="VM HEALTH CHECK" FontSize="17" FontWeight="Bold" Foreground="#38D6FF"/><TextBlock Text="Diagnostica rapida del PC con report in italiano. Sola lettura: non modifica nulla." Foreground="#8FA3C7" FontSize="12"/></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Name="lblComputer" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Name="lblAdmin" Foreground="#8FA3C7" FontSize="12" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#111F3A" BorderBrush="#1E3560" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Cliente / sede:" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox Name="txtCliente" Grid.Column="1" Margin="0,0,12,6"/>
                <TextBlock Text="Tecnico:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox Name="txtTecnico" Grid.Column="3" Margin="0,0,12,6"/>
                <Button Name="btnStart" Grid.Column="4" Content="Avvia diagnostica" Style="{StaticResource Primary}" Margin="0,0,0,6"/>
                <TextBlock Text="Salva in:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Name="txtOut"/><Button Name="btnBrowse" Grid.Column="1" Content="..." Padding="8,5" Margin="6,0,0,0"/></Grid>
                <CheckBox Name="chkDeep" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Analisi approfondita (SFC/DISM, +3-10 minuti)" VerticalAlignment="Center"/>
                <CheckBox Name="chkPdf" Grid.Row="1" Grid.Column="4" Content="Crea anche PDF" IsChecked="True" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#111F3A" BorderBrush="#1E3560" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox Name="lstLog" Background="#060D1C" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="#9FE8FF"/>
                <TextBlock Name="lblStatus" Grid.Row="1" Text="Pronto." Foreground="#8FA3C7" Margin="0,8,0,4"/>
                <ProgressBar Name="progressBar" Grid.Row="2" Height="14" Minimum="0" Maximum="100" Foreground="#38D6FF" Background="#0B1730" BorderBrush="#1E3560"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Name="lblResult" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
            <Button Name="btnOpenHtml" Grid.Column="1" Content="Apri report" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Name="btnOpenPdf" Grid.Column="2" Content="Apri PDF" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Name="btnOpenFolder" Grid.Column="3" Content="Apri cartella" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
